{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudyShield",
  "version": "1.0.0",
  "identifier": "app.studyshield.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "StudyShield — Private Local AI Study Coach",
      "width": 1440,
      "height": 900,
      "minWidth": 390,
      "minHeight": 680,
      "resizable": true,
      "center": true,
      "backgroundColor": "#05070f",
      "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-http-cache"
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
